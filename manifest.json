{
  "manifest_version": 3,
  "name": "UCSC Schedule → Google Calendar",
  "version": "0.0.1",
  "description": "Export your UCSC class schedule to Google Calendar as recurring weekly events, one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Export UCSC schedule"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://ucsc.collegescheduler.com/*",
    "https://my.ucsc.edu/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://ucsc.collegescheduler.com/*"],
      "js": ["src/content/myscheduler.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/lib/schedule-parse.mjs"],
      "matches": ["https://ucsc.collegescheduler.com/*"]
    }
  ]
}
