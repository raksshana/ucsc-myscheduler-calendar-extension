{
  "manifest_version": 3,
  "name": "UCSC Schedule Exporter",
  "version": "0.5.0",
  "description": "Export your UCSC class schedule to Google Calendar as recurring weekly events, one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "UCSC Schedule Exporter"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://ucsc.collegescheduler.com/*",
    "https://my.ucsc.edu/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "713570157767-nk0vlt4ovqrt1b7k6lqc2iv0q5n82knn.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
      "https://www.googleapis.com/auth/calendar.app.created"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://ucsc.collegescheduler.com/*"],
      "js": ["src/content/myscheduler.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://my.ucsc.edu/*"],
      "js": ["src/content/myucsc.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/lib/schedule-parse.mjs", "src/lib/myucsc-parse.mjs"],
      "matches": ["https://ucsc.collegescheduler.com/*", "https://my.ucsc.edu/*"]
    }
  ]
}
